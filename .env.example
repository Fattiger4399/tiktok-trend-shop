# Copy to .env for local development. Do not commit real credentials.

TTS_ENV=development
TTS_DATABASE_URL=sqlite:///./data/tiktok_trend_shop.sqlite3
TTS_STORAGE_BACKEND=local
TTS_STORAGE_ROOT=./assets

TTS_REGIONS=US
TTS_CATEGORIES=beauty,home
TTS_SOURCE_PROVIDERS=manual
TTS_AI_PROVIDERS=mock
TTS_FEATURE_FLAGS=manual_ingestion,local_assets

# Example provider configuration. Keep disabled unless credentials are present.
TTS_SOURCE_MANUAL_ENABLED=true
TTS_SOURCE_MANUAL_BASE_URL=
TTS_SOURCE_MANUAL_API_KEY=

TTS_AI_MOCK_ENABLED=false
TTS_AI_MOCK_BASE_URL=
TTS_AI_MOCK_API_KEY=
